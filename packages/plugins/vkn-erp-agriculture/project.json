{
  "name": "plugin-vkn-erp-agriculture",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/plugins/vkn-erp-agriculture/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/plugins/vkn-erp-agriculture",
        "main": "packages/plugins/vkn-erp-agriculture/src/index.ts",
        "tsConfig": "packages/plugins/vkn-erp-agriculture/tsconfig.lib.json",
        "assets": ["packages/plugins/vkn-erp-agriculture/*.md"]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "packages/plugins/vkn-erp-agriculture/jest.config.ts"
      }
    }
  },
  "tags": ["scope:plugins", "type:vkn-erp"]
}
